fn main(): int {
  println(2 < 2);
  println(1 < 2);
  println(2 < 1);

  println(2 > 2);
  println(1 > 2);
  println(2 > 1);

  println(2 <= 2);
  println(1 <= 2);
  println(2 <= 1);

  println(2 >= 2);
  println(1 >= 2);
  println(2 >= 1);

  println(2 == 2);
  println(1 == 2);
  println(2 == 1);

  println(2 != 2);
  println(1 != 2);
  println(2 != 1);

  return 0;
}